# Cấu hình Firebase để gửi kỷ lục lên Cloud Firestore (xem src/online.ts và README).
# Chép file này thành .env.local rồi điền giá trị lấy ở Firebase Console > Project settings > General > Your apps
# (đối tượng firebaseConfig của web app). Bỏ trống thì game vẫn chạy, chỉ không gửi kỷ lục lên mạng.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
