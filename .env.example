# Cấu hình Firebase để gửi kỷ lục lên Cloud Firestore (xem src/online.ts và README).
# Chép file này thành .env.local rồi điền giá trị lấy ở Firebase Console > Project settings > General > Your apps
# (đối tượng firebaseConfig của web app). Bỏ trống thì game vẫn chạy, chỉ không gửi kỷ lục lên mạng.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Đấu online (xem src/pvp và README, mục "Đấu online").
# Địa chỉ Realtime Database (Firebase Console > Build > Realtime Database, dạng https://<project>-default-rtdb.<vùng>.firebasedatabase.app).
# Bỏ trống thì menu không có nút "Đấu online".
VITE_FIREBASE_DATABASE_URL=
# Máy chủ TURN của Metered (metered.ca > TURN Server > Credentials): tên miền dạng <app>.metered.live
# và API key của một credential (không phải Secret Key của tài khoản). Bỏ trống thì chỉ dùng STUN.
VITE_METERED_DOMAIN=
VITE_METERED_API_KEY=
