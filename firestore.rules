rules_version = '2';

// Quy tắc bảo mật của Cloud Firestore cho game (xem src/online.ts).
// Dán vào Firebase Console > Firestore Database > Rules rồi bấm Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi người chơi một document, mã là uid đăng nhập ẩn danh của họ.
    match /highscores/{uid} {
      // Ai cũng đọc được, để làm bảng xếp hạng chung
      allow read: if true;
      // Chỉ chính người chơi được ghi document của mình
      allow create: if isOwner(uid) && isValid(request.resource.data);
      // Kỷ lục chỉ được tăng (hoặc giữ nguyên khi đổi tên)
      allow update: if isOwner(uid) && isValid(request.resource.data)
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }
  }

  function isOwner(uid) {
    return request.auth != null && request.auth.uid == uid;
  }

  function isValid(d) {
    let fields = ['name', 'score', 'stage', 'updatedAt'];
    return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
      // Game giới hạn tên 20 ký tự; ở đây nới rộng hơn cho chắc
      && d.name is string && d.name.size() > 0 && d.name.size() <= 40
      && d.stage is int && d.stage >= 1
      // Thua ở màn n thì điểm không thể vượt n * 1500 (MAX_SCORE_PER_STAGE trong src/game/scoring.ts)
      && d.score is int && d.score > 0 && d.score <= d.stage * 1500
      && d.updatedAt == request.time;
  }
}
